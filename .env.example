APP_NAME=GuideMate
APP_ENV=local
APP_DEBUG=true
# Leave APP_URL empty to auto-detect. Set it if you use a custom vhost, e.g. http://guidemate.test
APP_URL=
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en

EXPO_PUBLIC_API_BASE_URL=http://10.0.4.99/GuideMate/public

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=guidemate
DB_USERNAME=root
DB_PASSWORD=

SESSION_NAME=guidemate_session
SESSION_LIFETIME=7200

# Email (leave MAIL_FROM empty to log only in debug mode)
MAIL_FROM=
MAIL_FROM_NAME=GuideMate
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Optional integrations
OPENWEATHER_API_KEY=
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=
MAPILLARY_ACCESS_TOKEN=
SMS_API_KEY=
SMS_SENDER=GuideMate
USD_PHP_RATE=56.0

# Social sign-in (Google / Facebook)
# Leave SOCIAL_AUTH_DEMO=true to let the buttons work without real OAuth apps
# (anonymous demo accounts; no real email/password is ever stored). Set it to
# false and fill the values below to require real, verified provider tokens.
SOCIAL_AUTH_DEMO=true
# Comma-separated list of accepted Google OAuth client IDs (web/iOS/Android/Expo)
GOOGLE_OAUTH_CLIENT_IDS=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Mobile app API — set to your PC LAN IP so Expo Go can reach the server, e.g. http://192.168.1.10/GuideMate/GuideMate-Mobile/GuideMate
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10/GuideMate/public
# APP_URL=http://localhost/GuideMate/public
